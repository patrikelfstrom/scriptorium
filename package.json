{
  "name": "scriptorium",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "db:prepare": "tsx ./scripts/prepare-catalog-database.ts",
    "db:reset": "tsx ./scripts/reset-catalog-database.ts",
    "dev:worker": "pnpm db:prepare && tsx watch ./scripts/dev-worker.ts",
    "dev:worker:cf": "pnpm db:prepare && wrangler dev worker/index.ts",
    "build": "pnpm typecheck && pnpm build:app && pnpm build:worker",
    "build:app": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\"",
    "sync:npm-catalog": "tsx ./scripts/sync-npm-catalog.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify": "pnpm format && pnpm lint && pnpm test && pnpm build",
    "verify:fix": "pnpm lint:fix && pnpm format:fix && pnpm verify",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "download-counts": "^2.20260901.0",
    "lucide-react": "^1.64.0",
    "p-queue": "^9.3.5",
    "p-retry": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0"
    }
  },
  "packageManager": "pnpm@11.27.0"
}
